# Database (Supabase pooler, port 6543)
DATABASE_URL=postgresql://user:password@host:6543/postgres
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LiveKit Cloud
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_URI=sip:<sip-subdomain>.sip.livekit.cloud
LIVEKIT_SIP_USERNAME=rescue-inbound
LIVEKIT_SIP_PASSWORD=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Google Gemini (LLM)
GOOGLE_API_KEY=

# UpliftAI (TTS)
UPLIFTAI_API_KEY=
